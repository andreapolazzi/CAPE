{% extends "master.html" %}

<style> {
  .box {
      display: flex;
      align-items: flex-start; /* Allinea la checkbox e il testo in alto */
      padding: 15px;
      border: 1px solid #ddd;
      border-radius: 5px;
      background-color: #f9f9f9;
      transition: background-color 0.3s ease;
  }
  
  .box input[type="checkbox"] {
      margin-right: 15px; /* Spazio tra la checkbox e il testo */
      margin-top: 5px; /* Allinea meglio la checkbox con il testo se il testo ha padding */
      width: 20px; /* Dimensione del pallino */
      height: 20px; /* Dimensione del pallino */
      cursor: pointer;
  }

  .box label {
      display: flex; /* Permette al testo di wrappare */
      cursor: pointer;
      flex-grow: 1; /* Permette alla label di occupare lo spazio rimanente */
  }
  
  .box p {
      margin: 0; /* Rimuovi il margine predefinito dal paragrafo */
      line-height: 1.5;
  }
  
  /* Stile per il box quando selezionato */
  .box.selected {
      background-color: #e0f2f7; /* Un blu chiaro */
      border-color: #a7d9ee;
  }
  
  button {
      padding: 10px 20px;
      background-color: #007bff;
      color: white;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      font-size: 16px;
      margin-top: 10px;
  }
  
  button:hover {
      background-color: #0056b3;
  }
</style>

{% block title %}BACMAN- pathways{% endblock %}


{% block content %}
    <h2>Pathways found</h2>
    <h3> Using annotated pathways and Retropath, our tool has been able to find the 3 best pathways that lead from the starting to the final compounds chosen as inputs </h3>

    <div class="box">
        <input type="checkbox" id="checkbox1">
        <label for="checkbox1">
            <p>testo del primo box</p>
        </label>
    </div>
    <div class="box">
        <input type="checkbox" id="checkbox2">
        <label for="checkbox2">
            <p>2</p>
        </label>
    </div>
    <div class="box">
        <input type="checkbox" id="checkbox3">
        <label for="checkbox3">
            <p>3</p>
        </label>
    </div>

    <a href="/fasta">
      <button type= "submit" id="confirmButton">Conferma Selezione</button>
    </a>
    
{% endblock %}


